# Copy to `.transcriber.env` (gitignored) and fill in real values.
# This file feeds the worker container via `env_file` in docker-compose.transcriber.yml.
#
# PostgreSQL URL of the instance DB. In local dev this is the WSL-hosted Postgres
# reachable from containers via host.docker.internal.
DATABASE_URL=postgresql://postgres:changeme@host.docker.internal:5432/christiantube?schema=public

# GitHub repo that receives transcripts/insights (see instances/*/config.json -> releasesRepo).
GITHUB_REPO=rozariopersonal/Christian-Tube-Releases

# Fine-grained PAT with "Contents: Read and write" on the releases repo only.
# For a headless machine, do NOT use the repo clone URL token embedded in git config.
GITHUB_TOKEN=github_pat_CHANGEME