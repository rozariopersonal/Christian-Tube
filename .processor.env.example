# Copy to `.processor.env` (gitignored) and fill in real values.
# Feeds the youtube-processor container via `env_file` in docker-compose.yml.

# PostgreSQL URL of the instance DB.
DATABASE_URL=postgresql://postgres:postgres@db:5432/christiantube?schema=public

# GitHub Releases repository to update audio catalog
GITHUB_REPO=rozariopersonal/Christian-Tube-Releases

# Fine-grained GitHub PAT with "Contents: Read and write" on the releases repo
GITHUB_TOKEN=github_pat_CHANGEME

# Audio.com OAuth/Bearer token for programmatic audio uploads
AUDIO_COM_TOKEN=eyJ...

# Optional: comma-separated channel IDs processed first (in priority order).
# Then Tamil channels by video count (largest first), then English channels by
# video count, then all other languages by video count; within each channel the
# most recently uploaded video is processed first. When unset, only the
# language/video-count/recency ordering applies (no channel is pushed first).
PRIORITY_CHANNEL_IDS=UCpZG4Vl2tqg5cIfGMocI2Ag

# Optional: absolute path to the eligible-videos SQL query file. Defaults to
# services/youtube-processor/eligible_videos.sql, which is read from disk on
# every batch and bind-mounted read-only into the container, so you can edit
# the query at any time (no rebuild or restart needed).
# ELIGIBLE_SQL_PATH=/app/eligible_videos.sql

# Optional: comma-separated channel NAME filter (ILIKE) to restrict processing
# to specific channels, e.g. CHANNELS="CFC Songs & Hymns,Maasilla Valibam".
# Leave unset to process all active channels.
CHANNELS=
