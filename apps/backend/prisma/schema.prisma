generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoType {
  VIDEO
  SHORT
}

enum TranscriptionStatus {
  pending
  processing
  completed
  failed
}

model Video {
  id                     String              @id // YouTube Video ID
  type                   VideoType           @default(VIDEO)
  title                  String
  description            String              @db.Text
  thumbnail              String
  channelId              String
  channelName            String
  channelThumbnail       String?
  channelSubscriberCount String?
  publishedAt            DateTime
  duration               String
  viewCount              Int                 @default(0)
  tags                   String[]            @default([])
  category               String?

  transcriptionStatus    TranscriptionStatus @default(pending)
  transcriptionProgress  Int?
  transcriptionRetryCount Int                @default(0)
  transcriptionDetail    Json?
  lastTranscriptionError String?
  content                String?             @db.Text

  // Creator & Clipping Metadata
  creatorUserId          String?
  creatorName            String?
  creatorEmail           String?
  sourceVideoId          String?
  clipStartTime          Float?
  clipEndTime            Float?
  cropOffsetX            Float?              @default(0.0)
  clippedAt              DateTime?

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  channel                Channel?            @relation(fields: [channelId], references: [id])
  // shortCreations back-relation removed; ShortCreation now tracks by youtubeVideoId only

  @@index([channelId])
  @@index([publishedAt])
  @@index([type])
  @@index([category])
  @@index([sourceVideoId])
  @@index([type, publishedAt(sort: Desc)])
  @@index([channelId, type, publishedAt(sort: Desc)])
}

model Channel {
  id              String         @id // YouTube Channel ID
  name            String
  description     String?        @db.Text
  thumbnail       String?
  subscriberCount String?
  category        String?
  language        String?
  isActive        Boolean        @default(true)
  syncCursor      String?
  syncStatus      String         @default("IDLE")
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  videos          Video[]
  subscriptions   ChannelSubscription[]

  @@index([isActive])
  @@index([category])
}

model ChannelSubscription {
  id        String   @id @default(uuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@index([createdAt])
}

model ChannelRequest {
  id              String         @id @default(uuid())
  channelUrl      String
  notes           String?
  status          String         @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedBy     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model User {
  id            String                @id
  email         String                @unique
  displayName   String?
  photoUrl      String?
  isBlocked     Boolean               @default(false)
  role          String                @default("USER") // "ADMIN" or "USER"
  lastLoginAt   DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subscriptions ChannelSubscription[]
  shortCreations ShortCreation[]

  @@index([isBlocked])
  @@index([email])
}

model MicroFeedItem {
  id               String   @id @default(uuid())
  engine           String   @default("scripture") // "scripture", "quote", "devotional"
  bookNumber       Int?
  bookName         String?
  chapter          Int?
  startVerse       Int?
  endVerse         Int?
  referenceLabel   String
  text             String?  @db.Text
  verseMappings    Json?    @db.JsonB
  translation      String   @default("WEB")
  category         String   @default("General")
  backgroundPreset String   @default("mountain_dawn")
  tags             String[] @default([])
  likesCount       Int      @default(0)
  sharesCount      Int      @default(0)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([engine])
  @@index([category])
  @@index([isFeatured])
}

model DailyQuotaLog {
  date            String   @id // YYYY-MM-DD (UTC)
  unitsConsumed   Int      @default(0)
  unitsLimit      Int      @default(10000)
  lastUpdated     DateTime @default(now())
}

model ShortCreation {
  id              String   @id @default(uuid())
  userId          String?
  userEmail       String?
  creatorName     String?
  youtubeVideoId  String   @unique // Each published YouTube Short maps to exactly one creation record
  sourceVideoId   String?
  title           String
  description     String?  @db.Text
  thumbnail       String?
  durationSeconds Int?     @default(60)
  clipStartTime   Float?
  clipEndTime     Float?
  cropOffsetX     Float?   @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Note: no FK to Video — the video row may not exist yet when record-creation is called

  @@index([userId])
  @@index([userEmail])
  @@index([youtubeVideoId])
  @@index([createdAt])
}

model UserPlayback {
  id              String   @id @default(uuid())
  userEmail       String
  userId          String?
  deviceId        String?
  mediaType       String   @default("audio") // "audio" or "video"
  trackId         String
  seriesId        String?
  title           String?
  speaker         String?
  coverUrl        String?
  audioUrl        String?
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  payloadJson     String?  @db.Text
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userEmail, mediaType])
  @@index([userEmail])
  @@index([userId])
  @@index([mediaType])
  @@index([updatedAt])
}

