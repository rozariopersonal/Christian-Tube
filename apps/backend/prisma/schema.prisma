generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoType {
  VIDEO
  SHORT
}

enum TranscriptionStatus {
  pending
  processing
  completed
  failed
}

model Video {
  id                     String              @id // YouTube Video ID
  type                   VideoType           @default(VIDEO)
  title                  String
  description            String              @db.Text
  thumbnail              String
  channelId              String
  channelName            String
  channelThumbnail       String?
  channelSubscriberCount String?
  publishedAt            DateTime
  duration               String
  viewCount              Int                 @default(0)
  tags                   String[]            @default([])
  category               String?
  metadata               Json?

  transcriptionStatus    TranscriptionStatus @default(pending)
  transcriptionProgress  Int?
  transcriptionRetryCount Int                @default(0)
  transcriptionDetail    Json?
  lastTranscriptionError String?
  contentVersion         Int?                @default(0)

  embeddingStatus        String?             @default("pending")
  embeddingVersion       Int?                @default(0)
  embeddingHash          String?
  embeddingError         String?
  embeddingRetryCount    Int?                @default(0)

  // Creator & Clipping Metadata
  creatorUserId          String?
  creatorName            String?
  creatorEmail           String?
  sourceVideoId          String?
  clipStartTime          Float?
  clipEndTime            Float?
  cropOffsetX            Float?              @default(0.0)
  clippedAt              DateTime?

  // Audio Extraction Metadata
  audioUrl               String?
  audioUploadStatus      String?
  audioRetryCount        Int?                @default(0)
  audioLastError         String?

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  channel                Channel?            @relation(fields: [channelId], references: [id])
  videoEmbedding         VideoEmbedding?
  transcription          Transcription?
  videoChunks            VideoChunk[]
  videoIdeas             VideoIdea[]
  videoSentences         VideoSentence[]
  // shortCreations back-relation removed; ShortCreation now tracks by youtubeVideoId only

  @@index([channelId])
  @@index([publishedAt])
  @@index([type])
  @@index([category])
  @@index([sourceVideoId])
  @@index([type, publishedAt(sort: Desc)])
  @@index([channelId, type, publishedAt(sort: Desc)])
  @@index([embeddingStatus])
  @@index([transcriptionStatus])
}

model VideoEmbedding {
  videoId   String   @id
  embedding Unsupported("vector(384)")?
  model     String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([version])
  @@map("VideoEmbedding")
}

model Transcription {
  videoId        String   @id
  content        String   @db.Text    // [mm:ss mm:ss] sentence lines
  source         String   @default("parakeet") // parakeet | caption
  contentVersion Int      @default(0)
  wordCount      Int?
  segmentCount   Int?
  maxSec         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contentVersion])
  @@map("Transcription")
}

model VideoIdea {
  id            String          @id @default(uuid())
  videoId       String
  seq           Int
  title         String?
  summary       String?         @db.Text
  startSec      Float
  endSec        Float
  sentenceCount Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  video         Video           @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sentences     VideoSentence[]

  @@unique([videoId, seq])
  @@index([videoId, startSec])
  @@map("VideoIdea")
}

model VideoSentence {
  id              String      @id @default(uuid())
  videoId         String
  ideaId          String?
  seq             Int
  text            String      @db.Text
  startSec        Float
  endSec          Float
  embeddingStatus String      @default("pending") // pending | completed | failed
  createdAt       DateTime    @default(now())

  video           Video       @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  idea            VideoIdea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([videoId, seq])
  @@index([videoId, startSec])
  @@index([ideaId])
  @@index([embeddingStatus])
  @@map("VideoSentence")
}

model VideoChunk {
  id        Int      @id @default(autoincrement())
  videoId   String
  seq       Int
  kind      String   @default("idea") // idea | quote
  title     String? // short statement describing the idea
  content   String   @db.Text // idea summary / embedded text
  quoteText String?  @db.Text // verbatim transcript quote
  scriptureRefs Json? // ["John 17:23"] grounded refs
  startSec  Float?
  endSec    Float?
  source    String   @default("caption") // caption | parakeet
  embedding Unsupported("vector(384)")? // filled asynchronously by the embedding service
  model     String? // null until embedded
  version   Int      @default(0) // embedding model snapshot version
  digest    String?
  embeddingStatus String   @default("pending") // pending | processing | completed | failed
  embeddingError   String?  @db.Text
  embeddingRetryCount Int?  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([videoId, seq])
  @@index([model, version])
  @@index([embeddingStatus])
  @@map("VideoChunk")
}

model Channel {
  id              String         @id // YouTube Channel ID
  name            String
  description     String?        @db.Text
  thumbnail       String?
  subscriberCount String?
  category        String?
  language        String?
  isActive        Boolean        @default(true)
  syncCursor      String?
  syncStatus      String         @default("IDLE")
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  videos          Video[]
  subscriptions   ChannelSubscription[]

  @@index([isActive])
  @@index([category])
}

model ChannelSubscription {
  id        String   @id @default(uuid())
  userId    String
  channelId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@index([createdAt])
}

model ChannelRequest {
  id              String         @id @default(uuid())
  channelUrl      String
  notes           String?
  status          String         @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedBy     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model User {
  id            String                @id
  email         String                @unique
  displayName   String?
  photoUrl      String?
  isBlocked     Boolean               @default(false)
  role          String                @default("USER") // "ADMIN" or "USER"
  lastLoginAt   DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subscriptions ChannelSubscription[]
  shortCreations ShortCreation[]

  @@index([isBlocked])
  @@index([email])
}

model MicroFeedItem {
  id               String   @id @default(uuid())
  engine           String   @default("scripture") // "scripture", "quote", "devotional"
  bookNumber       Int?
  bookName         String?
  chapter          Int?
  startVerse       Int?
  endVerse         Int?
  referenceLabel   String
  text             String?  @db.Text
  verseMappings    Json?    @db.JsonB
  translation      String   @default("WEB")
  category         String   @default("General")
  backgroundPreset String   @default("mountain_dawn")
  tags             String[] @default([])
  likesCount       Int      @default(0)
  sharesCount      Int      @default(0)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([engine])
  @@index([category])
  @@index([isFeatured])
}

model DailyQuotaLog {
  date            String   @id // YYYY-MM-DD (UTC)
  unitsConsumed   Int      @default(0)
  unitsLimit      Int      @default(10000)
  lastUpdated     DateTime @default(now())
}

model ShortCreation {
  id              String   @id @default(uuid())
  userId          String?
  userEmail       String?
  creatorName     String?
  youtubeVideoId  String   @unique // Each published YouTube Short maps to exactly one creation record
  sourceVideoId   String?
  title           String
  description     String?  @db.Text
  thumbnail       String?
  durationSeconds Int?     @default(60)
  clipStartTime   Float?
  clipEndTime     Float?
  cropOffsetX     Float?   @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Note: no FK to Video — the video row may not exist yet when record-creation is called

  @@index([userId])
  @@index([userEmail])
  @@index([youtubeVideoId])
  @@index([createdAt])
}

model UserPlayback {
  id              String   @id @default(uuid())
  userEmail       String
  userId          String?
  deviceId        String?
  mediaType       String   @default("audio") // "audio" or "video"
  trackId         String
  seriesId        String?
  title           String?
  speaker         String?
  coverUrl        String?
  audioUrl        String?
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  payloadJson     String?  @db.Text
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([userEmail, mediaType])
  @@index([userEmail])
  @@index([userId])
  @@index([mediaType])
  @@index([updatedAt])
}

model AudioSeries {
  id          String       @id
  title       String
  description String?      @db.Text
  speaker     String?
  category    String?
  language    String?
  coverUrl    String?
  trackCount  Int          @default(0)
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  tracks      AudioTrack[]

  @@index([category])
  @@index([speaker])
  @@index([updatedAt])
}

model AudioTrack {
  id               String       @id
  seriesId         String
  title            String
  speaker          String?
  durationSeconds  Int          @default(0)
  audioUrl         String
  streamUrl        String?
  fallbackUrl      String?
  ifCoverUrl       String?
  thumbnailUrl     String?
  youtubeVideoId   String?
  scriptureBook    String?
  scriptureChapter Int?
  scriptureVerse   Int?
  updatedAt        DateTime     @updatedAt
  createdAt        DateTime     @default(now())

  series           AudioSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@index([speaker])
  @@index([updatedAt])
}
