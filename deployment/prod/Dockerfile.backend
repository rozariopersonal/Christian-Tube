# ─── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install OpenSSL and libc compatibility for Prisma on Alpine
RUN apk add --no-cache openssl libc6-compat
RUN npm install -g pnpm@latest

# Copy dependency manifests
COPY package.json pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/backend/prisma ./apps/backend/prisma/

# Install dependencies
RUN pnpm install --frozen-lockfile=false

# Copy source code and instances
COPY apps/backend ./apps/backend
COPY instances ./instances

# Generate Prisma client and compile NestJS app
WORKDIR /app/apps/backend
RUN npx prisma generate
RUN pnpm build

# ─── Stage 2: Runner ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Install OpenSSL and pnpm for runtime
RUN apk add --no-cache openssl libc6-compat
RUN npm install -g pnpm@latest

COPY package.json pnpm-workspace.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/backend/prisma ./apps/backend/prisma/

# Install production dependencies
RUN pnpm install --prod --frozen-lockfile=false

# Copy built artifacts and prisma client
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /app/instances ./instances

EXPOSE 3000

WORKDIR /app/apps/backend
CMD ["sh", "-c", "npx prisma db push --skip-generate && node dist/src/main.js"]
