# ==============================================================================
# Common Shared Configuration for All Services (Example Template)
# Copy to envs/common.env and fill in real tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Third-Party Tokens & Releases Repository
# ------------------------------------------------------------------------------
GITHUB_REPO=rozariopersonal/Christian-Tube-Releases
GITHUB_TOKEN=ghp_your_github_token_here
AUDIO_COM_TOKEN=your_audio_com_token_here

# ------------------------------------------------------------------------------
# 2. Shared Daemon Settings (Processor, Transcriber, Chunker, Embedder)
# ------------------------------------------------------------------------------
PRIORITY_CHANNEL_IDS=UCpZG4Vl2tqg5cIfGMocI2Ag
POLL_INTERVAL=300
BATCH_LIMIT=50
MAX_RETRIES=3
WORK_DIR=/work
RELEASES_DIR=/app/releases
LOCAL_DATABASE_URL=postgresql://postgres:postgres@db:5432/christiantube?schema=public

# ------------------------------------------------------------------------------
# 3. Backend API Settings (NestJS)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
INSTANCE_ID=christian_tube
SHORTS_CUSTOM_CHANNEL_ID=UCSaJppP4zb2vivjxYfTqOKw
ADMIN_EMAILS=arul.rozario4@gmail.com,admin@privatetube.org
CHAT_ENABLED=false
CHAT_MODEL=gemini-3.1-flash
CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
CHAT_TIMEOUT_MS=60000
GEMINI_API_KEY=
EMBEDDING_PROVIDER=self-hosted
EMBEDDING_SERVICE_URL=

# ------------------------------------------------------------------------------
# 4. Transcriber Settings (Parakeet ASR)
# ------------------------------------------------------------------------------
CONTENT_VERSION=2
LOG_SENTENCES=true
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
PYTHON_BIN=python

# ------------------------------------------------------------------------------
# 5. Chunker Settings (Ollama LLM)
# ------------------------------------------------------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
CHUNK_VERSION=2
LOG_IDEAS=true

# ------------------------------------------------------------------------------
# 6. Embedder Settings (ONNX Gemma Vector Embedder)
# ------------------------------------------------------------------------------
ONNX_DIR=/model
EMBEDDING_MODEL=onnx-community/embeddinggemma-300m-ONNX
EMBEDDING_DIM=768
EMBEDDING_VERSION=3
EMBEDDING_MAX_TOKENS=2048
EMBED_CHUNKS=1
EMBED_CHUNK_BATCH=32
