# ==============================================================================
# Master Environment Architecture
#
# Docker Compose merges two files for every service:
#   1. envs/common.env            (All shared tokens, models, daemon configs)
#   2. ${ENV_FILE:-envs/neon.env} (The specific target database overrides)
#
# How to Run:
#   docker compose up -d                          # Connects to Neon Cloud DB (default)
#   docker compose --env-file envs/local.env up -d # Connects to Local Docker DB
#   docker compose --env-file envs/neon.env up -d  # Connects to Neon Cloud DB explicitly
# ==============================================================================

# ------------------------------------------------------------------------------
# Target Database Override Example (like envs/local.env or envs/neon.env)
# ------------------------------------------------------------------------------
ENV_FILE=envs/example.env
ENV_NAME=example

DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
