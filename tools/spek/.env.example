# SPEK Analyzer environment variables (copy to .env and fill as needed)

# Ollama endpoint (defaults to http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Web research provider: none | duckduckgo | opencode
# SPEK_RESEARCH_PROVIDER=duckduckgo

# When using the 'opencode' research provider, the child opencode process needs
# web search enabled. Set one of these to a truthy value (1) before running:
# OPENCODE_ENABLE_EXA=1
# OPENCODE_ENABLE_PARALLEL=1

# Optional Exa / Tavily keys if you later add keyed search backends
# EXA_API_KEY=
# TAVILY_API_KEY=