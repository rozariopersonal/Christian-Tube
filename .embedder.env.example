# Copy to .embedder.env and fill in. Used by docker-compose.yml `embedder` service.
# Use the DIRECT (non-pooled) connection when possible for DDL (extension/index).
# DATABASE_URL is used as fallback.
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_VERSION=2
EMBEDDING_MAX_TOKENS=256
POLL_INTERVAL=300
BATCH_LIMIT=32
MAX_RETRIES=3